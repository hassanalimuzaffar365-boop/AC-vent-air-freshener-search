# Serper.dev — free search API (2,500 free queries, no credit card)
# Get your key at https://serper.dev after signing up
SERPER_API_KEY=

# Google Gemini — free AI API (no credit card)
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which Gemini model to use. Check aistudio.google.com for the current
# model with the best free daily quota (avoid anything with "3.5" in the
# name - it has a very low free tier of ~20 requests/day; also avoid
# non-"-preview" short names like "gemini-3-flash" which may 404 - check
# the exact name via https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY).
# gemini-3-flash-preview has worked reliably during development.
GEMINI_MODEL=gemini-3-flash-preview

# Supabase — free database (no credit card)
# Get these from your Supabase project: Settings -> API
# (Used starting Day 2 — not needed for Day 1 testing)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=